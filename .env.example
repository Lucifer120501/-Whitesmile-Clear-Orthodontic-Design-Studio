# Google Drive Service Account Credentials.
# Either set GDRIVE_SERVICE_ACCOUNT_KEY directly as JSON, or point to a local file.
# The service account must have readonly access to the shared Drive folder/file.
GDRIVE_SERVICE_ACCOUNT_KEY="{\"type\":\"service_account\",\"project_id\":\"...\",\"private_key_id\":\"...\",\"private_key\":\"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\"...}"
# GDRIVE_SERVICE_ACCOUNT_KEY_FILE="./service-account-key.json"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ═══════════════════════════════════════════════════════════════════════════
# Headless Blender Integration
# ═══════════════════════════════════════════════════════════════════════════
# Full path to the Blender executable for headless STL processing.
# If unset, main.py will search common install locations per OS.
#
# Windows Example:
#   BLENDER_PATH="C:\Program Files\Blender Foundation\Blender 4.2\blender.exe"
# macOS Example:
#   BLENDER_PATH="/Applications/Blender.app/Contents/MacOS/Blender"
# Linux Example:
#   BLENDER_PATH="/usr/bin/blender"
BLENDER_PATH=""

